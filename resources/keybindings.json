{
  "$schema": "https://pi.dev/schemas/keybindings.schema.json",
  "app.session.new": "ctrl+j",
  "app.session.resume": ["ctrl+alt+j"],
  "app.session.tree": "ctrl+alt+t",
  "tui.editor.cursorUp": ["up", "ctrl+p"],
  "tui.editor.cursorDown": ["down", "ctrl+n"],
  "tui.select.up": ["up", "ctrl+p"],
  "tui.select.down": ["down", "ctrl+n"],
  "app.editor.external": ["ctrl+alt+g"],
  "app.interrupt": ["escape", "ctrl+g"],
  "tui.select.cancel": ["escape", "ctrl+g"],
  "app.model.cycleForward": "ctrl+alt+l",
  "tui.altScreen.lineUp": "ctrl+alt+p",
  "tui.altScreen.lineDown": "ctrl+alt+n",
  "tui.altScreen.halfPageUp": "alt+p",
  "tui.altScreen.halfPageDown": "alt+n",
  "app.clipboard.pasteImage": "alt+v"
}
